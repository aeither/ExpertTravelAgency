{
  "name": "origin2026hack",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "demo": "TRAVEL_MODE=demo tsx src/server.ts",
    "build": "tsc",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start:built": "node dist/server.js",
    "check": "tsc --noEmit && tsc -p tsconfig.tools.json",
    "test": "tsx --test test/*.test.ts",
    "openapi": "tsx scripts/openapi.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "verify:swagger": "tsx scripts/verify-swagger.ts",
    "demo:buy": "tsx scripts/demo-buy.ts",
    "smoke": "tsx scripts/smoke.ts",
    "sokosumi:worker": "tsx scripts/sokosumi-worker.ts",
    "verify:receipt": "tsx scripts/verify-receipt.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@fastify/static": {
      "content-disposition": "1.1.0"
    }
  }
}
