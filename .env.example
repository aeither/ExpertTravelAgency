HOST=127.0.0.1
PORT=3026
# live calls suppliers. demo returns synthetic data and simulated bookings.
TRAVEL_MODE=live
# Required before you bind to a public interface. Send Authorization: Bearer <key>.
API_KEY=
DATA_PATH=.data/origin.sqlite
# Cloud deployment uses Neon instead of SQLite; unpooled URL supports job locks.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
CRON_SECRET=
PUBLIC_SEARCH=false
# Flights are off by default. Set true to enable the Duffel flight endpoints.
FLIGHTS_ENABLED=false
DUFFEL_ACCESS_TOKEN=
# Hotel search. A sand_ key uses the LiteAPI sandbox; free at https://dashboard.liteapi.travel
LITEAPI_API_KEY=
LIVE_BOOKINGS_ALLOWED=false
# Guest name and email used when a chat message books a hotel without naming one.
GUEST_GIVEN_NAME=Alex
GUEST_FAMILY_NAME=Traveller
GUEST_EMAIL=alex.traveller@example.com
UPSTREAM_TIMEOUT_MS=45000
# live uses a Masumi Payment Service. simulated is a labelled rehearsal with no chain, for demos.
MASUMI_MODE=live
# Separate Masumi Payment Service. The URL must include /api/v1.
MASUMI_URL=http://127.0.0.1:3012/api/v1
MASUMI_TOKEN=
MASUMI_AGENT_IDENTIFIER=
MASUMI_SUPPORTED_SOURCE_INDEX=0
# Cardano Preprod only. Price for search work, not supplier bookings.
MASUMI_PRICE_ATOMIC=1000000
MASUMI_TOKEN_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d
# Sokosumi task worker (Preprod; dedicated Coworker runtime credential)
SOKOSUMI_COWORKER_ID=
SOKOSUMI_COWORKER_API_KEY=
ORIGIN_TRAVEL_URL=https://origin-travel-agent.vercel.app
SOKOSUMI_WORKER_DATA_PATH=.data/sokosumi-worker

# AI agent: OpenRouter key and model (openrouter/free picks a free model that fits each request)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
